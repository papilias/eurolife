@using Wedia.Foundation.Dictionary.Extensions
@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Feature.News
@using Sitecore.Resources.Media
@model IEnumerable<Sitecore.Data.Items.Item>

<section class="center center--1100 m-b-112">
  <h1 class="h4 t-c">@Html.Sitecore().Dictionary("/news/Latest News/Title", "Latest News")</h1>
  <div class="t-c m-b-48 m-t-8">
    @Html.Sitecore().Dictionary("/news/Latest News/Description", "Corporate Social Responsibility Latest Activities")
  </div>
  <div class="latest">
    @foreach (var item in Model)
    {
    <article>
      
      @Html.Sitecore().ImageField(Templates.NewsArticle.Fields.DesktopImage, item, Templates.NewsArticle.Dimensions.LatestArticlesImageHeight, Templates.NewsArticle.Dimensions.LatestArticlesImageWidth)
      <div class="latest__details">
        <time>@Html.Sitecore().Field(Templates.NewsArticle.Fields.Date, item)</time>
        <h2 class="h6 latest__title">
          <a href="@item.Url()">
            @Html.Sitecore().Field(Templates.NewsArticle.Fields.Title, item)
          </a>
        </h2>
      </div>
    </article>
    }
  </div>
</section>
