@using Wedia.Feature.Person
@using Wedia.Foundation.SitecoreExtensions.Extensions
@model Wedia.Feature.Person.Models.ResultsViewModel
@{
    var prevButtonAttributes = "";
    var nextButtonAttributes = "";
    var nextPageUrl = $"{Request.Url.AbsolutePath}?page={Model.Page + 1}";

    if (Model.Page >= Model.TotalPagesCount - 1)
    {
        nextPageUrl = "#";
        nextButtonAttributes = "class=dispabled";
    }

    var prevPageUrl = $"{Request.Url.AbsolutePath}?page{Model.Page - 1}";

    if (Model.Page <= 0)
    {
        prevPageUrl = "#";
        prevButtonAttributes = "class=disabled";
    }

}
<div class="some container i think">
    @foreach (var result in Model.Results.Results)
    {
        <div class="maybe-card">
            @if (result.Item.FieldHasValue(Templates.Person.Fields.DesktopImage))
            {
                <a href="@result.Url">
                   @Html.Sitecore().ImageField(Templates.Person.Fields.DesktopImage, result.Item)
                </a>
            }
            <a href="@result.Url">
                @result.Item.Field(Templates.Person.Fields.Title)
            </a>
        </div>
    }

    <div class="pagination">
        <ul>
            <li @prevButtonAttributes>
                <a href="@prevPageUrl">&laquo;</a>
            </li>

            @for (var i = Model.FirstPage; i <= Model.LastPage; i++)
            {
                <li class="@(Model.Page == i ? "active" : string.Empty )">
                    <a href="@Request.Url.AbsolutePath?page=@i">@(i + 1)</a>
                </li>
            }

            <li @nextButtonAttributes>
                <a href="@nextPageUrl">&raquo;</a>
            </li>
        </ul>
    </div>
</div>
