@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Foundation.Dictionary.Extensions
@using Wedia.Feature.Panels
@model  IEnumerable<Wedia.Feature.Panels.Models.PanelRow>

@if (Model == null || !Model.Any())
{
    return;
}

<div class="filter">
    <span class="filter__trigger">@Html.Sitecore().Dictionary("/Panel/Product Panel/Filters Title", "FILTER RESULTS")</span>
    <div class="filter__results">
        @foreach (var filter in Model)
        {
            <div class="filter__results__column">
                <div class="filter__results__heading">@filter.Title</div>
                @foreach (var prop in filter.Props.Select((value, i) => new { i, value }))
                {
                    <div class="filter__item">
                        <input type="checkbox" id="check-@prop.value.ConvertedName" data-index="@prop.value.ConvertedName">
                        <label for="check-@prop.value.ConvertedName">@prop.value.Value</label>
                    </div>
                }
            </div>
        }
    </div>

</div>
