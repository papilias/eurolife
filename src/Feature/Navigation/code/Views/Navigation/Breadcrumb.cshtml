@using Wedia.Feature.Navigation
@using Wedia.Foundation.SitecoreExtensions.Extensions
@model Wedia.Feature.Navigation.Models.NavigationItems

<ul class="breadcrumbs center center--1700 m-t-48">
    @foreach (var item in Model.NavItems)
    {
        <li>
            <a href="@item.Item.Url()">@Html.Sitecore().Field(Templates.Navigable.Fields.NavigationTitle, item.Item) </a>
        </li>
    }
</ul>


