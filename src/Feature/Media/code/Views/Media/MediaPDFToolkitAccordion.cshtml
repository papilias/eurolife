@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Feature.Media
@model Sitecore.Mvc.Presentation.RenderingModel
@{
    if (!Model?.Item?.DescendsFrom(Templates.HasPDFs.ID) ?? true)
    {
        return;
    }

}

<span></span>

@foreach (var item in Model.Item.GetMultiListValueItems(Templates.HasPDFs.Fields.Files))
{
    using (Html.BeginEditFrame(item.ID.ToString(), ""))
    {
        <a href="@item.ImageUrl(Templates.PDF.Fields.File)" download="true">
            @item.Field(Templates.PDF.Fields.Title)
        </a>
    }
}
