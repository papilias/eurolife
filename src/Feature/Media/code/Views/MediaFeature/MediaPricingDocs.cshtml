@using Wedia.Feature.Media
@using Wedia.Feature.Media.Repositories
@using Wedia.Foundation.Alerts
@using Wedia.Foundation.Alerts.Extensions
@using Wedia.Foundation.Dictionary.Extensions
@using Wedia.Foundation.SitecoreExtensions.Extensions


<div>
  <h3>
    @Html.Sitecore().Dictionary("/Media/PricingDocs/Title", "Pricing Docs")
  </h3>
  <p>
    @Html.Sitecore().Dictionary("/Media/PricingDocs/Description")
  </p>


  <p>Date: <input type="text" id="datepickerFiles"></p>
  <p>
    <a href="javascript;" id="btnDownloadDoc">@Html.Sitecore().Dictionary("/Media/PricingDocs/Download", "Download")</a>     
  </p>
  <p>
    <label id="lblWarning" style="display:none;"> @Html.Sitecore().Dictionary("/Media/PricingDocs/FileNotFound", "File not found")</label>
  </p>
</div>