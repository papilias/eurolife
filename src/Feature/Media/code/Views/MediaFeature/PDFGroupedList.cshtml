@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Feature.Media.Models
@using Wedia.Feature.Media
@using Sitecore.Mvc.Presentation
@model PDFGroups
@{
  var groups = new PDFGroups();
  var activeSubgroup = new PDFGroup();
}

<div class="color-container">
  <div class="center center--1700 m-b-64 ">
    @foreach (var parentCategories in Model.Groups)
    {
      {
        if (parentCategories.IsActive)
        {
          groups = parentCategories.SubGroups;
        }
      }

      <a href="@($" {RenderingContext.Current.ContextItem.Url()}?group={parentCategories.Item.ID}")"
         class="tab  @(parentCategories.IsActive ? "tab--active" : "")">
        @parentCategories.Item.Field(Templates.PDFGroup.Fields.Title)
      </a>

    }
  </div>
</div>
@if (groups.Groups != null && groups.Groups.Any())
{

  <section>
    <div class="center--1100 center">
      <div class="droplist js-droplist">
        @{
          var listItems = string.Empty;
        }
        @foreach (var subGroup in groups.Groups)
        {
          if (subGroup.IsActive)
          {
            activeSubgroup = subGroup;
            <label class="droplist-trigger" aria-label="Συνοπτικά οικονομικά στοιχεία" role="button">
              @subGroup.Item.Field(Templates.PDFGroup.Fields.Title)
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="60" height="60" viewBox="0 0 60 60">
                <defs>
                  <path id="a" d="M41.118 32.08L23.029 50.137a2.948 2.948 0 0 1-4.166 0 2.938 2.938 0 0 1 0-4.159l16.005-15.98-16.005-15.978a2.938 2.938 0 0 1 0-4.16 2.95 2.95 0 0 1 4.166 0l18.09 18.06c.574.574.862 1.326.862 2.079a2.93 2.93 0 0 1-.863 2.08z"></path>
                </defs>
                <use fill="#003B4D" fill-rule="nonzero" transform="rotate(90 29.99 30)" xlink:href="#a"></use>
              </svg>
            </label>
          }
          else
          {
            listItems += $@"
            <li>
              <a href='{RenderingContext.Current.ContextItem.Url()}?group={subGroup.Item.ID}'>
                {subGroup.Item.Fields[Templates.PDFGroup.Fields.Title]?.Value}
              </a>
            </li>";
          }
        }
        <div class="droplist__options">
          <ul>
            @Html.Raw(listItems)
          </ul>
        </div>
      </div>
    </div>
  </section>
}



@if (activeSubgroup.PDFs != null && activeSubgroup.PDFs.Any())
{
  <div class="list center center--1100 m-b-112">
    <div class="list__filters m-b-48">
    </div>

    @foreach (var pdf in activeSubgroup.PDFs)
    {
      <div class="list__item list__item--triple">
        <h4 class="list__title">@pdf.Field(Templates.HasMedia.Fields.Title)</h4>
        <div class="list__size">@pdf.FileSize(Templates.PDF.Fields.File)</div>
        <div class="list__download">
          <a href="@pdf.ImageUrl(Templates.PDF.Fields.File)" 
             aria-label="@pdf.Fields[Templates.HasMedia.Fields.Title].Value" 
             role="button" 
             class="btn btn--dark btn--icon btn--icon-download"
             download="true"></a>
        </div>
      </div>
    }
  </div>
}

