@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Feature.Media
@using Wedia.Foundation.Alerts
@using Wedia.Foundation.Alerts.Extensions
@using Wedia.Foundation.Dictionary.Extensions

@model Sitecore.Mvc.Presentation.RenderingModel
@{
  if (!Model?.Item?.DescendsFrom(Templates.PDFGroup.ID) ?? true)
  {
    @Html.PageEditorError(AlertTexts.InvalidDataSourceTemplate(Templates.PDFGroup.ID), AlertTexts.InvalidDataSourceTemplateFriendlyMessage, Model.Item?.ID, Model.Rendering.Item?.ID)
    return;
  }

  var items = Model.Item.GetMultiListValueItems(Templates.PDFGroup.Fields.Files);
}

@if ((items == null || !items.Any()) && Sitecore.Context.PageMode.IsNormal)
{
  return;
}

@using (Html.BeginEditFrame(Model.Item.ID.ToString(), ""))
{
  <section class="list center center--1100 m-b-112 m-t-112">
    <h1 class="h3 m-b-48">@Html.Sitecore().Field(Templates.PDFGroup.Fields.Title)</h1>

    @foreach (var item in items)
    {

      <div class="list__item list__item--double">
        <div class="list--double__info">
          <h4 class="list--double__title">@item.Field(Templates.HasMedia.Fields.Title)</h4>
          <div class="list--double__subtitle">@item.Field(Templates.HasMedia.Fields.Description)</div>
        </div>

        <div class="list__download">
          <a class="btn btn--dark btn--icon btn--icon-download" href="@item.ImageUrl(Templates.PDF.Fields.File)" download="true"></a>
        </div>
      </div>
    }

  </section>

}