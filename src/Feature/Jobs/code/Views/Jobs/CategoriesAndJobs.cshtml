@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Foundation.Dictionary.Extensions
@using Wedia.Feature.Jobs
@model Wedia.Feature.Jobs.Models.JobPageViewModel

@if (Model.JobCategories != null && Model.JobCategories.Any())
{
<section class="list center center--1100 m-b-112">
  @foreach (var category in Model.JobCategories)
  {
    if (category.Item.FieldHasValue(Templates.HasJobCategory.Fields.JobCategoryTitle))
    {
      <section class="center center--1100 m-b-48 section-header-summary">
        <h1 class="h4 t-c">@category.Item.Field(Templates.HasJobCategory.Fields.JobCategoryTitle)</h1>
      </section>
    }   
    if (category.Jobs != null && category.Jobs.Any())
    {
      foreach (var job in category.Jobs)
      {
        <article class="list__item list__item--ghost list__item--double">
          <div class="list--double__info">
            @if (job.Item.FieldHasValue(Templates.HasJob.Fields.JobDate))
            {
              <time>@Html.Sitecore().Field(Templates.HasJob.Fields.JobDate, job.Item, new { format = "d MMM yyyy", DisableWebEdit = true })</time>
            }
            @if (job.Item.FieldHasValue(Templates.HasJob.Fields.JobTitle))
            {
              <h4 class="list__title">
                @Html.Sitecore().Field(Templates.HasJob.Fields.JobTitle, job.Item, new { DisableWebEdit = true })
              </h4>
            }
            @if (job.Item.FieldHasValue(Templates.HasJob.Fields.JobDescription))
            {
              <p class="list--double__info">
                @Html.Sitecore().Field(Templates.HasJob.Fields.JobDescription, job.Item, new { DisableWebEdit = true })
              </p>
            }
          </div>
          @if (job.Item.FieldHasValue(Templates.HasJob.Fields.JobLink))
          {
            <div class="list__download">
              <a href="@job.Item.LinkFieldUrl(Templates.HasJob.Fields.JobLink)"
                 aria-label="@Html.Sitecore().Dictionary("/Jobs/ApplyForJob", "Apply for job")"
                 role="button"
                 class="btn btn--ghost-rev btn--default">
                @Html.Sitecore().Dictionary("/Jobs/ApplyForJob", "Apply for job")
              </a>
            </div>
          }
        </article>
      }
    }
  }
</section>
}