@using Wedia.Foundation.Alerts
@using Wedia.Foundation.Alerts.Extensions
@using Wedia.Foundation.SitecoreExtensions.Extensions
@using Wedia.Feature.Highlight
@model IEnumerable<Sitecore.Data.Items.Item> 

@{
    if (Model == null)
    {          
        return;
    } 
}    

<section class="m-t-64 m-b-96 center center--1100 triplette">
    @foreach (var item in Model)
    {          
        <a class="triplette-item triplette-item--linked radius-t" href="@item.LinkFieldUrl(Templates.HighlightCTA.Fields.CTA)">
            <h3 class="h6 m-b-8 triplette-item--linked__title">@Html.Sitecore().Field(Templates.HighlightMain.Fields.Title, item)</h3>
            <p>
                @Html.Sitecore().Field(Templates.HighlightMain.Fields.Summary, item)
            </p>
        </a>     
    }
</section>  
